{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickyBoard",
  "version": "1.1.0",
  "identifier": "com.stickyboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StickyBoard",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "tausif2907",
    "copyright": "© 2026 tausif2907",
    "category": "Productivity",
    "shortDescription": "Free-form sticky-note boards",
    "longDescription": "Write anywhere on a long sheet, paste images, highlight text, add sticky notes, text boxes, speech bubbles and drawings, then export to PDF or PNG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
